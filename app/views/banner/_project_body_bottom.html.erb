<div id="project_banner_area" class="banner_area">
  <div class="banner banner_<%= banner.style %>" id="banner_content">
    <% if banner.role.present? %>
      <span class="banner-role-label <%= banner_role_color_class(banner.role) %>">
        <%= banner.role.name %>
      </span>
    <% end %>

    <%#= textilizable banner.banner_description %>
    <%= banner_expand_macros(
      textilizable(banner.banner_description),
      popup_enabled: banner.popup_enabled?,
      popup_content: banner.popup_content,
      popup_source: 'project'
    ).html_safe %>
  </div>

  <% if banner.popup_enabled? && banner.popup_content.present? %>
    <div class="banner-popup-source" data-source="project" style="display: none;">
      <div class="banner-popup-body"><%= textilizable(banner_expand_macros(banner.popup_content)) %></div>
    </div>
  <% end %>

<%
if authorize_for(:banner, :edit)
%>
<div class="banner_edit">
    <%= link_to(
          (banner_action_icon_edit + l(:button_edit)).html_safe,
          { controller: 'banner', action: 'show', project_id: @project, role_id: banner.role_id },
          class: 'banner-icon-edit-link',
          title: l(:button_edit)
        ) %>
    <%= link_to(
          (banner_action_icon_off + l(:button_off)).html_safe,
          '#',
          class: 'banner-icon-off-link',
          title: l(:banner_off),
          onclick: "$.ajax({" \
                   "url: '#{url_for(controller: :banner, action: 'project_banner_off', project_id: @project, role_id: banner.role_id)}'," \
                   "type: 'get'," \
                   "success: function(){ $('#project_banner_area').fadeOut(500, function(){ $(this).remove(); }); }" \
                   "}); return false;"
        ) %>
  </div>
<% end %>

</div>
<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    let content = document.getElementById('content');
    content.insertBefore(
      document.getElementById('project_banner_area'),
      content.firstChild
    );
  });
</script>
