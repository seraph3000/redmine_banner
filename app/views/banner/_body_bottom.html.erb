<div class="banner_area global_banner">
  <div class="banner banner_<%= setting['type'] %>" id="banner_content">
    <%#= textilizable setting['banner_description'] %>
    <%= banner_expand_macros(
        textilizable(setting['banner_description']),
        popup_enabled: setting['popup_enabled'] == 'true',
        popup_content: setting['popup_content'],
        popup_source: 'global').html_safe %>
  </div>

  <% if setting['popup_enabled'] == 'true' && setting['popup_content'].present? && !login_page? %>
    <div class="banner-popup-source" data-source="global" style="display: none;">
      <div class="banner-popup-body"><%= textilizable(banner_expand_macros(setting['popup_content'])) %></div>
    </div>
  <% end %>

  <div class="banner_edit">
    <%= link_to (banner_action_icon_edit + l(:button_edit)).html_safe,
          { controller: 'global_banner', action: 'show' },
          { class: 'banner-icon-edit-link', title: l(:button_edit) } if User.current.admin? %>
    <%= link_to(
          (banner_action_icon_off + l(:button_off)).html_safe,
          '#',
          class: 'banner-icon-off-link',
          title: l(:banner_off),
          onclick: "$.ajax({" \
                   "url: '#{url_for(controller: :banner, action: 'off')}'," \
                   "type: 'get'," \
                   "success: function(){ $('div.banner_area.global_banner').fadeOut(500, function(){ $(this).remove(); }); }" \
                   "}); return false;"
        ) if User.current.logged? %>
  </div>

  <% if (safe_url = banner_safe_external_url(setting['related_link'])) %>
  <div class="banner_more_info">
    <%= link_to l(:more_info), safe_url,
           { class: 'icon external', title: l(:label_more_info)} %>
  </div>
  <% end %>
</div>

<% if setting['display_part'] == 'header' %>
<script type="text/javascript">
  $(document).ready(function () {
    displayTopBanner();
  });

  $(window).resize(function () {
    console.log("resize");
    displayTopBanner();
  });
</script>
<% end %>

<% if setting['display_part'] == 'both' %>
<script type="text/javascript">
  $(document).ready(function () {
    displayTopAndBottomBanner();
  });

  $(window).resize(function () {
    console.log("resize");
    displayTopBanner();
  });
</script>
<% end %>